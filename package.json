{
  "name": "karpatskyi-shliakh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Карпатський шлях — туристична платформа «Мандруй Україною»: маршрути й конструктор походу в Карпати",
  "scripts": {
    "build:html": "node scripts/build-html.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/main.css --watch",
    "build": "npm run build:html && npm run build:css",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/",
    "check": "node scripts/check-site.mjs",
    "dist": "node scripts/make-dist.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
